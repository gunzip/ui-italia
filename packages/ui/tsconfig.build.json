{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.stories.*",
    "src/**/*.mdx",
    "src/docs/**"
  ]
}
