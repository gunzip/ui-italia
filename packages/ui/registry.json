{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ui-italia",
  "homepage": "https://gunzip.github.io/ui-italia",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "description": "The cn() class-merge helper used by all components.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:file",
      "description": "Italia design tokens: Tailwind v4 theme + CSS variables (light & dark).",
      "files": [
        {
          "path": "src/styles/globals.css",
          "type": "registry:file",
          "target": "~/styles/ui-italia.css"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "description": "Italia button: variants (default, outline, secondary, ghost, destructive, link) and sizes (sm, default, lg, icon).",
      "dependencies": ["@base-ui/react", "class-variance-authority", "cn"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "src/components/button.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
